# Build environment for the Aloha + UniXNU firmware, matching the Mi 9 port's CI
# (ubuntu-24.04, Python 3.12, clang/lld/llvm, iasl, nasm). Used by build-uefi.sh.
FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential uuid-dev bison flex nasm acpica-tools \
      python3 python3-venv python3-dev git ca-certificates curl unzip zip \
      clang lld llvm mtools dosfstools device-tree-compiler \
    && rm -rf /var/lib/apt/lists/*
# EDK II's CLANGPDB tool chain wants these exact names on PATH.
RUN for t in clang lld-link llvm-lib llvm-rc llvm-objcopy llvm-nm; do \
      command -v "$t" >/dev/null 2>&1 && continue; \
      cand=$(ls /usr/lib/llvm-*/bin/"$t" 2>/dev/null | sort -V | tail -1); \
      [ -n "$cand" ] && ln -sf "$cand" "/usr/local/bin/$t"; \
    done; \
    command -v clang lld-link llvm-lib llvm-rc llvm-objcopy llvm-nm iasl nasm
# Git refuses repositories owned by another uid unless told otherwise.
RUN git config --system --add safe.directory '*'
WORKDIR /work
