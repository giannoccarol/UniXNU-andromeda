+/* andrfbasync=1: show the latest frame, then any newer one; one copy at a time. */
+void
+AppleCLCD::presentAsync(void)
+{
+	for (;;) {
+		IOLockLock(fLock);
+		if (!fDirty || fPowerOff) {
+			fPresentBusy = false;
+			IOLockUnlock(fLock);
+			return;
+		}
+		memcpy(fAsyncRecord, fPending, SWEET_FB_SWAP_REC_SIZE);
+		fDirty = false;
+		IOLockUnlock(fLock);
+		uint64_t begin = mach_absolute_time();
+		present(fAsyncRecord);
+		uint64_t elapsed = mach_absolute_time() - begin;
+		IOLockLock(fLock);
+		fCopyTicks += elapsed;
+		if (elapsed > fCopyMax) {
+			fCopyMax = elapsed;
+		}
+		++fPresented;
+		IOLockUnlock(fLock);
+	}
+}
