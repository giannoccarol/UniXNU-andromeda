+/* One layer in logical coordinates (lx, ly, w, h from source sx, sy) -> panel. */
+void
+AppleCLCD::presentFit(SweetSurface *s, uintptr_t src, uint32_t bpe, int32_t sx, int32_t sy,
+    int32_t lx, int32_t ly, int32_t w, int32_t h)
+{
+	if (lx + w > (int32_t)fLogicalW) {
+		w = (int32_t)fLogicalW - lx;
+	}
+	if (ly + h > (int32_t)fLogicalH) {
+		h = (int32_t)fLogicalH - ly;
+	}
+	if (w > (int32_t)s->width - sx) {
+		w = (int32_t)s->width - sx;
+	}
+	if (h > (int32_t)s->height - sy) {
+		h = (int32_t)s->height - sy;
+	}
+	if (src == 0 || bpe != 4 || w <= 0 || h <= 0 || s->elementWidth != 1 ||
+	    s->elementHeight != 1 || s->memory == NULL ||
+	    (uint64_t)s->offset + (uint64_t)(sy + h - 1) * s->bytesPerRow + (uint64_t)(sx + w) * 4 >
+	    s->memory->getLength()) {
+		return;
+	}
+	/* Fitted columns/rows whose logical source lies inside the layer. */
+	int32_t x0 = (int32_t)(((uint64_t)lx * fWidth + fLogicalW - 1) / fLogicalW);
+	int32_t x1 = (int32_t)(((uint64_t)(lx + w) * fWidth + fLogicalW - 1) / fLogicalW);
+	int32_t y0 = (int32_t)(((uint64_t)ly * fWidth + fLogicalW - 1) / fLogicalW);
+	int32_t y1 = (int32_t)(((uint64_t)(ly + h) * fWidth + fLogicalW - 1) / fLogicalW);
+	x1 = x1 > fFitW ? fFitW : x1;
+	y1 = y1 > fFitH ? fFitH : y1;
+	for (int32_t y = y0; y < y1; y++) {
+		int32_t srow = (int32_t)fFitRow[y] - ly;
+		int32_t py = y + fFitOffY;
+		if (srow < 0 || srow >= h || py < 0 || py >= (int32_t)fHeight) {
+			continue;
+		}
+		uint32_t *dst = (uint32_t *)(fPixels + (uint64_t)py * fRowBytes);
+		const uint32_t *row = (const uint32_t *)(src + s->offset +
+		    (uint64_t)(sy + srow) * s->bytesPerRow) + sx;
+		for (int32_t x = x0; x < x1;) {
+			int32_t scol = (int32_t)fFitCol[x] - lx;
+			int32_t run = 1;
+			while (x + run < x1 && fFitCol[x + run] == fFitCol[x] + run) {
+				run++;
+			}
+			if (scol >= 0 && scol + run <= w) {
+				memcpy(dst + x, row + scol, (size_t)run * 4);
+				fCopiedBytes += (uint64_t)run * 4;
+			}
+			x += run;
+		}
+	}
+}
