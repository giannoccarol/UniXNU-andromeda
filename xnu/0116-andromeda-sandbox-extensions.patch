andromeda: sandbox extensions in the SWEET "Sandbox" policy (ios-sweet patch
0050, dipa-studio/ios-sweet; see CREDITS.md). Operation 5 (extension issue)
writes a well-formed token into the caller's buffer and operation 6
(extension consume) returns a handle, instead of ENOENT. Without them tccd
cannot hand out TCC extensions, assetsd aborts ("assetsd requires
TCCPhotosService access") and Photos aborts with an empty library. The
argument layouts are libsystem_sandbox's of iOS 16.7.16 (read from its code,
not copied). Boot-arg andrsbext=0 restores ENOENT. Needs patch 0115.

--- a/bsd/kern/sweet_amfi.c
+++ b/bsd/kern/sweet_amfi.c
@@ -24,11 +24,15 @@
  */
 #if defined(ARM64_BOARD_CONFIG_SWEET)
 #include <kern/debug.h>
+#include <kern/kalloc.h>
 #include <kern/startup.h>
+#include <libkern/OSAtomic.h>
 #include <libkern/amfi/amfi.h>
 #include <mach/kern_return.h>
+#include <pexpert/pexpert.h>
 #include <sys/codesign.h>
 #include <sys/mount.h>
+#include <sys/param.h>
 #include <sys/priv.h>
 #include <sys/proc.h>
 #include <sys/systm.h>
@@ -279,14 +283,123 @@
  * launchd reports mach lookups as "error = 159: Sandbox restriction"
  * (backboardd cannot reach mobilegestalt or iohideventsystem; tccd:
  * "profile not found"). SWEET runs without a sandbox: operations succeed
- * (checks allow, profile init is accepted); the few that must return
- * data (container paths, extension tokens) fail with ENOENT. The first
+ * (checks allow, profile init is accepted); container paths fail with
+ * ENOENT, extension tokens are made up (andromeda, below). The first
  * use of each operation number is logged.
  */
 static uint64_t sweet_sandbox_seen;
 
+/*
+ * andromeda: sandbox extensions, boot-arg andrsbext (default 1; 0 = ENOENT as
+ * before). With ENOENT tccd cannot hand out TCC extensions ("Failed to issue
+ * Sandbox Extension for kTCCServicePhotos"): assetsd aborts ("assetsd requires
+ * TCCPhotosService access") and so does Photos ("Invalid parameter not
+ * satisfying: assetsDataSourceManager.dataSource.numberOfSections == 1").
+ * Arguments as libsystem_sandbox of iOS 16.7.16 passes them (read from its
+ * code; every field 64 bits):
+ *   op 5 issue:   { class, type, name (0 for generic), flags, token buffer
+ *                 (0x800 bytes, the library returns it as the token), pid,
+ *                 pid version }
+ *   op 6 consume: { token, strlen(token) + 1, pointer to the i64 handle }
+ *                 (the library returns the handle, -1 on an error)
+ *   op 7 release: { handle, 0, 0 } (accepted, as every other operation)
+ * Nothing is enforced here, so a token only has to be a well-formed string:
+ * 64 hex digits (no MAC), zero fields, the class length, the class, the type
+ * and the name, separated by ';'. Handles count up from 1. The first 32
+ * issues and 8 consumes are logged.
+ */
+#define SWEET_SB_EXT_TOKEN_MAX  0x800
+#define SWEET_SB_EXT_CLASS_MAX  256
+static int sweet_sandbox_ext_on = -1;
+static volatile SInt64 sweet_sandbox_ext_count;
+static volatile SInt32 sweet_sandbox_ext_logged_issue, sweet_sandbox_ext_logged_consume;
+
+static int
+sweet_sandbox_ext_issue(struct proc *p, user_addr_t arg)
+{
+	uint64_t a[7];
+	char cls[SWEET_SB_EXT_CLASS_MAX] = "";
+	char *name = NULL, *token = NULL;
+	size_t done = 0;
+	uint64_t n, mix;
+	int len, error = copyin(arg, a, sizeof(a));
+
+	if (error) {
+		return error;
+	}
+	if (a[0] == 0 || a[4] == 0) {
+		return EINVAL;
+	}
+	error = copyinstr((user_addr_t)a[0], cls, sizeof(cls), &done);
+	if (error) {
+		return error;
+	}
+	name = kalloc_data(MAXPATHLEN, Z_WAITOK | Z_ZERO);
+	token = kalloc_data(SWEET_SB_EXT_TOKEN_MAX, Z_WAITOK | Z_ZERO);
+	if (name == NULL || token == NULL) {
+		error = ENOMEM;
+		goto out;
+	}
+	if (a[2] != 0) {
+		error = copyinstr((user_addr_t)a[2], name, MAXPATHLEN, &done);
+		if (error) {
+			goto out;
+		}
+	}
+	n = (uint64_t)OSIncrementAtomic64(&sweet_sandbox_ext_count) + 1;
+	mix = n * 0x9e3779b97f4a7c15ULL ^ (uint64_t)proc_pid(p);
+	len = snprintf(token, SWEET_SB_EXT_TOKEN_MAX,
+	    "%016llx%016llx%016llx%016llx;00;00000000;00000000;00000000;%016llx;%s;%02llx;%s",
+	    (unsigned long long)mix, (unsigned long long)(mix ^ 0x5bd1e9955bd1e995ULL),
+	    (unsigned long long)~mix, (unsigned long long)n, (unsigned long long)strlen(cls), cls,
+	    (unsigned long long)(a[1] & 0xff), name);
+	if (len < 0 || len >= SWEET_SB_EXT_TOKEN_MAX) {
+		error = ENAMETOOLONG;
+		goto out;
+	}
+	error = copyout(token, (user_addr_t)a[4], (size_t)len + 1);
+	if (OSIncrementAtomic(&sweet_sandbox_ext_logged_issue) < 32) {
+		char who[32];
+		proc_name(proc_pid(p), who, sizeof(who));
+		printf("SWEET Sandbox: %s issues %s type %llu flags %#llx pid %lld%s%s -> %d\n",
+		    who, cls, (unsigned long long)a[1], (unsigned long long)a[3], (long long)a[5],
+		    name[0] ? " name " : "", name, error);
+	}
+out:
+	if (name != NULL) {
+		kfree_data(name, MAXPATHLEN);
+	}
+	if (token != NULL) {
+		kfree_data(token, SWEET_SB_EXT_TOKEN_MAX);
+	}
+	return error;
+}
+
+static int
+sweet_sandbox_ext_consume(struct proc *p, user_addr_t arg)
+{
+	uint64_t a[3];
+	int error = copyin(arg, a, sizeof(a));
+
+	if (error) {
+		return error;
+	}
+	if (a[0] == 0 || a[2] == 0) {
+		return EINVAL;
+	}
+	int64_t handle = OSIncrementAtomic64(&sweet_sandbox_ext_count) + 1;
+	error = copyout(&handle, (user_addr_t)a[2], sizeof(handle));
+	if (OSIncrementAtomic(&sweet_sandbox_ext_logged_consume) < 8) {
+		char who[32];
+		proc_name(proc_pid(p), who, sizeof(who));
+		printf("SWEET Sandbox: %s consumes an extension (%llu bytes) -> handle %lld (%d)\n",
+		    who, (unsigned long long)a[1], (long long)handle, error);
+	}
+	return error;
+}
+
 static int
-sweet_sandbox_syscall(struct proc *p, int call, __unused user_addr_t arg)
+sweet_sandbox_syscall(struct proc *p, int call, user_addr_t arg)
 {
 	if (call >= 0 && call < 64 && !(sweet_sandbox_seen & (1ULL << call))) {
 		sweet_sandbox_seen |= 1ULL << call;
@@ -294,10 +407,17 @@
