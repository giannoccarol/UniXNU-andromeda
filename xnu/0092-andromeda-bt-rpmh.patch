+
+/*
+ * andromeda (Mi Mix 3 5G) WCN3990 Bluetooth supplies, patch 0092: the three
+ * rails of the live DT node bt_wcn3990 (qca,bt-vdd-{core,pa,ldo}-voltage-level),
+ * exact voltages only. on: voltage, HPM (PMIC5 LDO raw mode 7), enable, as
+ * the 0062 sequence; off: enable=0 only (Linux qcom-rpmh-regulator disable).
+ * ACTIVE set only; same rh_lock, idle-slot checks and timeout quarantine.
+ * EBUSY: lock held or no free slot; the caller may retry. A successful vote
+ * is not proof that the rail reached its voltage.
+ */
+int
+andromeda_rpmh_bt_rail(const char *res, bool on)
+{
+	static const struct { const char *res; unsigned mv; } rails[] = {
+		{"ldoa7", 1800},    /* PM8150 L7A, vdd-core (WCN xo) */
+		{"ldoc2", 1304},    /* PM8150L L2C, vdd-pa (rf) */
+		{"ldoc11", 3312},   /* PM8150L L11C, vdd-ldo (ch0) */
+	};
+	unsigned mv = 0;
+	for (unsigned i = 0; res && i < sizeof(rails) / sizeof(rails[0]); ++i) {
+		if (!strcmp(res, rails[i].res)) {
+			mv = rails[i].mv;
+		}
+	}
+	if (!mv) {
+		printf("SWEET RPMH: %s is not an andromeda BT rail; refusing\n", res ? res : "(null)");
+		return EINVAL;
+	}
+	if (__atomic_exchange_n(&rh_lock, 1, __ATOMIC_ACQUIRE)) {
+		return EBUSY;
+	}
+	int error = EIO;
+	uint32_t address = 0;
+	if (rh_poisoned) {
+		printf("SWEET RPMH: previous uncertain transaction; refusing further access\n");
+		goto out;
+	}
+	error = rh_map();
+	if (!error) {
+		error = rh_lookup(res, &address);
+	}
+	if (!error) {
+		const uint32_t on_offsets[3] = {0, 8, 4}, on_values[3] = {mv, 7, 1};
+		const uint32_t off_offsets[1] = {4}, off_values[1] = {0};
+		error = on ? rh_send_cmds(address, 3, on_offsets, on_values) :
+		    rh_send_cmds(address, 1, off_offsets, off_values);
+	}
+out:
+	printf("ANDROMEDA RPMH: %s %s %u mV result=%d%s\n", res, on ? "on" : "off", mv, error,
+	    rh_poisoned ? " (RPMh quarantined for this boot)" : "");
+	__atomic_store_n(&rh_lock, 0, __ATOMIC_RELEASE);
+	return error;
 }
 #include "cepheus_arc_probe.h"
