+/* The 0062 VRM sequence (voltage, HPM, enable) or the 0084 XOB enable only. */
+static int
+rh_send(uint32_t address, unsigned mv, bool xob)
+{
+	/* XOB only accepts enable at base+4. VRM keeps its original sequence. */
+	const uint32_t offsets[3] = {xob ? 4u : 0u, 8, 4};
+	const uint32_t values[3] = {xob ? 1u : mv, 7, 1};
+	if (xob) { printf("CEPHEUS POWER: ldoc1 XOB enable only address=%#x data=1\n", address + 4); }
+	if (!xob) { printf("SWEET RPMH: ACTIVE %u mV mode=7 enable=1\n", mv); }
+	return rh_send_cmds(address, xob ? 1u : 3u, offsets, values);
+}
