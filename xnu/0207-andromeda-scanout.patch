+bool
+AppleCLCD::scanRefuse(uint32_t why, uint32_t id)
+{
+	if (fScanRefused++ < 12) {
+		IOLog("SWEET FB: scanout refused surface %u (reason %u), copied\n", id, why);
+	}
+	return false;
+}
