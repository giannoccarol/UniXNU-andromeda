+/*
+ * andrscanout: a frame the pipe takes as it is: one layer showing the whole
+ * presented display from a BGRA surface of exactly that size, drawn by
+ * Metal (its GPU fence known and done), display on. True when the pipe has
+ * it; else the frame is copied as before.
+ */
+bool
+AppleCLCD::scanPresent(const uint8_t *rec)
+{
+	const unsigned mode = andromeda_scanout_mode();
+	if (mode == 0 || !fAsync || fPowerOff || fScanLock == NULL || andromeda_scanout_take_copy()) {
+		return false;   /* (scanout needs andrfbasync: the present path waits for the pipe) */
+	}
+	if (!fScanOn) {
+		/* Set the display up at the first frame Metal drew (mode 1), once. */
+		if (fScanTried || (mode == 1 && fCopyFence == 0)) {
+			return false;
+		}
+		fScanTried = true;
+		fScanOn = andromeda_scanout_init(fPhys, fRowBytes, fWidth, fHeight) == 0;
+		IOLog("SWEET FB: scanout %s\n", fScanOn ? "on: the display reads the frames itself" :
+		    "refused: CPU copy for this boot");
+		if (!fScanOn) {
+			return false;
+		}
+	}
+	uint32_t mask = get32(rec, 0x104), layer = 0;
+	if (mask == 0 || (mask & (mask - 1)) != 0) {
+		return scanRefuse(1, 0);
+	}
+	while (!(mask & (1u << layer))) {
+		layer++;
+	}
+	if (layer >= SWEET_FB_LAYERS) {
+		return scanRefuse(1, 0);
+	}
+	const uint32_t id = get32(rec, 0x54 + 4 * layer);
+	const uint8_t *a = rec + 0x64 + 16 * layer;
+	const uint8_t *b = rec + 0xc4 + 16 * layer;
+	int32_t sx = (int32_t)get32(a, 0), sy = (int32_t)get32(a, 4);
+	int32_t dx = (int32_t)get32(b, 0), dy = (int32_t)get32(b, 4);
+	int32_t w = (int32_t)get32(b, 8), h = (int32_t)get32(b, 12);
+	SweetSurface *s = id != 0 ? sweet_surface_copy(id) : NULL;
+	if (s == NULL || s == fSurface || s->memory == NULL) {
+		OSSafeReleaseNULL(s);
+		return scanRefuse(2, id);
+	}
+	if (w <= 0 || h <= 0) {
+		w = (int32_t)s->width;
+		h = (int32_t)s->height;
+	}
+	const uint64_t bytes = (uint64_t)s->bytesPerRow * s->height;
+	const uint32_t bpe = s->bytesPerElement ? s->bytesPerElement : 4;
+	if (sx != 0 || sy != 0 || dx != 0 || dy != 0 || w != (int32_t)fLogicalW || h != (int32_t)fLogicalH ||
+	    s->width != fLogicalW || s->height != fLogicalH || s->pixelFormat != SWEET_FB_FORMAT_BGRA || bpe != 4 ||
+	    s->elementWidth != 1 || s->elementHeight != 1 || s->planeCount > 1 || s->bytesPerRow < s->width * 4 ||
+	    s->bytesPerRow > 0xffff || (s->offset & 0xf) != 0 || s->offset + bytes > s->memory->getLength()) {
+		s->release();
+		return scanRefuse(3, id);
+	}
+	/* The frame's GPU work done (mode 2: and the CPU caches cleaned, for frames the CPU may have drawn). */
+	const uint64_t t0 = mach_absolute_time();
+	if (mode == 2) {
+		const uintptr_t kva = s->kernelAddress();
+		if (kva == 0) {
+			s->release();
+			return scanRefuse(4, id);
+		}
+		andromeda_fbsync_before_read_fence(kva + s->offset, bytes, fCopyFence);
+	} else if (andromeda_fbsync_wait(fCopyFence) != 0) {
+		s->release();
+		return scanRefuse(4, id);
+	}
+	const uint64_t t1 = mach_absolute_time();
+	fScanGpuAbs += t1 - t0;
+	const uint32_t iova = scanIova(s);
+	if (iova == 0) {
+		s->release();
+		return scanRefuse(5, id);
+	}
+	struct andr_scan_frame f;
+	f.iova = iova + s->offset;
+	f.stride = s->bytesPerRow;
+	if (fFit) {
+		/* 0094's fit: the whole presented display scaled by panel width / logical width, by QSEED3 */
+		f.src_x = f.src_y = 0;
+		f.src_w = fLogicalW;
+		f.src_h = fLogicalH;
+		f.dst_x = 0;
+		f.dst_y = (uint32_t)fFitOffY;
+		f.dst_w = (uint32_t)fFitW;
+		f.dst_h = (uint32_t)fFitH;
+	} else {
+		/* the centred panel-sized part, unscaled */
+		f.src_x = (uint32_t)(fOffX > 0 ? fOffX : 0);
+		f.src_y = (uint32_t)(fOffY > 0 ? fOffY : 0);
+		f.src_w = fWidth;
+		f.src_h = fHeight;
+		f.dst_x = f.dst_y = 0;
+		f.dst_w = fWidth;
+		f.dst_h = fHeight;
+	}
+	const int rc = andromeda_scanout_show(&f);
+	fScanShowAbs += mach_absolute_time() - t1;
+	if (rc != 0) {
+		s->release();
+		return scanRefuse(6, id);      /* the earlier flush not taken in 25 ms, or the frame refused */
+	}
+	/* show() waited for the earlier flush: the pipe reads the frame queued before, the one before that no more. */
+	IOLockLock(fScanLock);
+	if (fScanQueued != NULL) {
+		sweet_scan_drop(&fScanShown, fScanUse);
+		fScanShown = fScanQueued;
+		fScanQueued = NULL;
+	}
+	if (fScanShown == NULL) {
+		fScanUse = mode != 3;   /* the use count only changes with nothing held */
+	}
+	sweet_scan_hold(s, fScanUse);
+	fScanQueued = s;
+	fScanToPanel = false;
+	IOLockUnlock(fScanLock);
+	s->release();
+	return true;
+}
+
+/* andrscanout: the pipe back on the panel memory; the holds go once that is on screen (scanTick). */
+void
+AppleCLCD::scanPanel(void)
+{
+	if (!fScanOn || fScanLock == NULL) {
+		return;
+	}
+	IOLockLock(fScanLock);
+	const bool held = fScanShown != NULL || fScanQueued != NULL, going = fScanToPanel;
+	IOLockUnlock(fScanLock);
+	if (held && !going && andromeda_scanout_panel() == 0) {
+		IOLockLock(fScanLock);
+		fScanToPanel = true;
+		IOLockUnlock(fScanLock);
+	}
+}
+
+/* andrscanout, every vsync tick: once the last flush has been taken, let go of what the pipe no longer reads. */
+void
+AppleCLCD::scanTick(void)
+{
+	if (!fScanOn || fScanLock == NULL || !andromeda_scanout_latched()) {
+		return;
+	}
+	IOLockLock(fScanLock);
+	if (fScanToPanel) {
+		sweet_scan_drop(&fScanShown, fScanUse);
+		sweet_scan_drop(&fScanQueued, fScanUse);
+		fScanToPanel = false;
+	} else if (fScanQueued != NULL) {
+		sweet_scan_drop(&fScanShown, fScanUse);
+		fScanShown = fScanQueued;
+		fScanQueued = NULL;
+	}
+	IOLockUnlock(fScanLock);
+}
+
+/*
+ * andrscanout: after a frame went to the pipe (or the pipe went back to the panel memory), until the
+ * flush has been taken (at most a panel refresh); then the pipe no longer reads the frame before it
+ * and scanTick lets that go. False when that took over 50 ms.
+ */
+bool
+AppleCLCD::scanSettle(void)
+{
+	if (!fScanOn) {
+		return true;
+	}
+	const uint64_t t0 = mach_absolute_time();
+	const bool on = andromeda_scanout_wait_latched(50);
+	const uint64_t took = mach_absolute_time() - t0;
+	fLatchAbs += took;
+	fLatchMaxAbs = took > fLatchMaxAbs ? took : fLatchMaxAbs;
+	fLatchCount++;
+	fLatchLate += on ? 0 : 1;
+	scanTick();
+	return on;
+}
+
+/*
+ * swap_wait_gated's tests (iOS 16, as data-a-live's 0218 found them), fLock held. 0: the swap is off
+ * the screen (not queued, not active, not shown); 1: on screen or taken over (not queued, not
+ * active); 2: nothing queued or active. Display off: all done.
+ */
+bool
+AppleCLCD::swapDone(uint32_t id, uint32_t type)
+{
+	const bool queued = fDirty && id == fSwapQueued, active = fSwapActive != 0 && id == fSwapActive;
+	if (fPowerOff) {
+		return true;
+	}
+	switch (type) {
+	case 0:
+		return id == 0 || (!queued && !active && id != fSwapShown);
+	case 1:
+		return id == 0 || (!queued && !active);
+	default:
+		return !fDirty && fSwapActive == 0;
+	}
+}
+
+/*
+ * SwapWait (sel 6) [swap id, options, timeout ms]: options bit 31 asks without waiting (kIOReturnBusy
+ * while not done), the low bits are the test (swapDone; 3 asks whether the display is up: it is). A
+ * wait ends at its timeout (kIOReturnTimeout) or, given none, after 5 s (kIOReturnAborted).
+ */
+IOReturn
+AppleCLCD::swapWait(uint32_t id, uint32_t options, uint32_t timeoutMs)
+{
+	const uint32_t type = options & 0x7fffffffu;
+	IOReturn ret = type >= 4 ? kIOReturnBadArgument : kIOReturnSuccess;
+	IOLockLock(fLock);
+	fSwapWaits++;
+	if (type <= 2 && !swapDone(id, type)) {
+		if (options & 0x80000000u) {
+			ret = kIOReturnBusy;
+			fSwapBusy++;
+		} else {
+			uint64_t deadline;
+			nanoseconds_to_absolutetime((uint64_t)(timeoutMs ? timeoutMs : 5000) * NSEC_PER_MSEC, &deadline);
+			deadline += mach_absolute_time();
+			fSwapSlept++;
+			while (!swapDone(id, type)) {
+				if (mach_absolute_time() >= deadline) {
+					ret = timeoutMs ? kIOReturnTimeout : kIOReturnAborted;
+					fSwapTimeouts++;
+					break;
+				}
+				(void)IOLockSleepDeadline(fLock, &fSwapShown, *(AbsoluteTime *)&deadline, THREAD_UNINT);
+			}
+		}
+	}
+	const bool log = fSwapLogged < 24;
+	const uint32_t queued = fDirty ? fSwapQueued : 0, active = fSwapActive, shown = fSwapShown;
+	fSwapLogged += log ? 1 : 0;
+	IOLockUnlock(fLock);
+	if (log) {
+		IOLog("SWEET FB: swap wait %u options %#x timeout %u -> %#x (queued %u active %u shown %u)\n", id, options,
+		    timeoutMs, ret, queued, active, shown);
+	}
+	return ret;
+}
