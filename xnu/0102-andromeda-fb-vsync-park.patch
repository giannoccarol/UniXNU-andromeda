+/* andrfbpark: restart the parked vsync timer once the display is on again. */
+void
+AppleCLCD::vsyncResume(void)
+{
+	uint64_t deadline = 0;
+	IOLockLock(fLock);
+	if (fVsyncParked && !fPowerOff) {
+		fVsyncParked = false;
+		deadline = mach_absolute_time() + fPeriod;
+		fDeadline = deadline;           /* sweetfb_fixedtimer restarts from now */
+	}
+	IOLockUnlock(fLock);
+	if (deadline != 0) {
+		fVsync->wakeAtTime(deadline);
+		IOLog("SWEET FB: vsync resumed (display on)\n");
+	}
+}
